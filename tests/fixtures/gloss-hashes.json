{
  "w8-l1": {
    "en": "8ba7af16d39afbfaafdcc8816ccacf9e995fc5a7a94dbaf7e1b4b98a991ef59c",
    "glossYue": "設計工作跟得上進度，所以個會可以短啲。"
  },
  "w8-l2": {
    "en": "a08c746c4cc2dcba49a455b6fb4214c166fbacfbbb291759ea19a867b482d68e",
    "glossYue": "邊次樣辦落後咗，邊個負責嗰部分？"
  },
  "w8-l3": {
    "en": "6a69d61493fdf8ca67f9d598fb934f4dd52a8f7bb5905fc691d4be9b46ba489c",
    "glossYue": "嗰次樣辦落後咗，我負責。"
  },
  "w8-l4": {
    "en": "2ecf3277711cace5ac29530ebaf51de11d8dc31a539b19e5a727e01e4c45cdc4",
    "glossYue": "你可唔可以星期五之前跟進，再寫一張字條？"
  },
  "w8-l5": {
    "en": "567a67f83f9c2db86cfb22dc2501fc28ff2b0fe4ce74aa5066590191029a292a",
    "glossYue": "我星期五之前會跟進，同日送出字條。"
  },
  "w8-l6": {
    "en": "74d8dfd628ffd41377aa3eddf6a2c92eadad050285ac18a1185edf69d4753d9c",
    "glossYue": "寫低每項行動之前，仲有冇問題？"
  },
  "w8-l7": {
    "en": "d5d39fdd7b8818e4990cc9a9625cea4945924e14a58aabd223399169c07b6d85",
    "glossYue": "呢項行動我負責，我星期五會打畀客戶。"
  },
  "w8-l8": {
    "en": "bacccb63b791c57ce70a31371c194d1277782a2ecc0d262195de29288ffd11ba",
    "glossYue": "會後請送張字條嚟，等我睇。"
  },
  "w5-l1": {
    "en": "29c8505823c364725e8741a528cefdb7d566d686ceb54acc2a401e2d23122134",
    "glossYue": "我打嚟問一張單。參考編號喺盒上面。"
  },
  "w5-l2": {
    "en": "7c1862b28c114a8eea5c514c73f9b75ae0ac3a0e0cc0f42dc80b25dd71d456f9",
    "glossYue": "唔好意思，遲咗。我睇吓個扣。"
  },
  "w5-l3": {
    "en": "f68a4f85be5d8f6828d011a7a344d9990c331df3ce38210d7c46cb3a37bce820",
    "glossYue": "個扣上星期爛咗，唔該話我知清楚進度。"
  },
  "w5-l4": {
    "en": "12dccd2f6fcc59194d948502348ae9082452cf259da584001fac822d47d51a5d",
    "glossYue": "我今日會升級呢單，三個工作天內通知你。"
  },
  "w5-l5": {
    "en": "355df8df80b33e3b4ce926a0e0e11e2ef9b0b250d89364e0a3deff07607428df",
    "glossYue": "如果工場修唔好，可唔可以賠償或者換過？"
  },
  "w5-l6": {
    "en": "5da5c23291fb79833da8100c30b2efddaa214401deda4c52a35a207aee7b2812",
    "glossYue": "如果個扣修唔好，可以換貨或者賠償。"
  },
  "w5-l7": {
    "en": "2676b4e2cad9d5d5b06e356f5ca5c557bd4f80212e8d77cf48332042488aba2a",
    "glossYue": "盒上面個扣爛咗。問題就只有呢個。"
  },
  "w5-l8": {
    "en": "00519ba6358d7e4928869ec995167add9c48be21bee4fe5500316751e972ca3d",
    "glossYue": "我星期五會打電話話你知進度，等工場同意。"
  },
  "d3-l1": {
    "en": "a1283745d24f487c387e269067e55bfae13ab7461df057988f0071d6b70d8fbb",
    "glossYue": "早晨。我可以帶你睇呢間有傢俬嘅單位，租約包水。"
  },
  "d3-l2": {
    "en": "550476dcc372aecd829ab256ea96b776cfcaff51dd8c0b51305788cf7bf8db99",
    "glossYue": "月租幾多，水費有冇連埋其他水電煤？"
  },
  "d3-l3": {
    "en": "7f50057f906f06a336e6daaadb5a8ff3c28f8f8f8f6dbc2c7aa1412dc1bd0473",
    "glossYue": "月租每個月一號交，按金係一個月租。"
  },
  "d3-l4": {
    "en": "818811cad97396da2e488a4d32a8b8694ba27d229468bcaf4146370b220e3082",
    "glossYue": "水費連埋水電煤，月租維持不變。"
  },
  "d3-l5": {
    "en": "6daac1d092d3dcfb3da510b449e7016225a1fed5c881e108a2bf8dbca68ae623",
    "glossYue": "如果我今日決定，我就簽租約，並付代理費。"
  },
  "d3-l6": {
    "en": "52b4d5277255278b613295ec9a431a7f5ab8ab0e54f8f1e64e702b8fb706535f",
    "glossYue": "單位已經有傢俬，水電煤會用租客個名。"
  },
  "d3-l7": {
    "en": "aebd6461ac410b7362312d81f81b2348a851b2026a3fa2ea8c6dc4c1072a3125",
    "glossYue": "請同我睇份合約同通知，我先交按金。"
  },
  "d3-l8": {
    "en": "a6c8802659d92c46d44cc792bb966446cd6a575ef1025a8e5c268420804be3f4",
    "glossYue": "你簽租約，按金過咗數，業主就可以交鎖匙。"
  },
  "r6-l1": {
    "en": "67a463df497289086cec616df41f57af111e06d8f073a78aadba7dfc1bde62db",
    "glossYue": "你好。我想幫 Mei 訂檯，今晚仲有冇靠窗位？"
  },
  "r6-l2": {
    "en": "b361750b41572994d6fd64e45966dab328ea7716a9d14f78616422a0fbce88d0",
    "glossYue": "靠窗位有空，Mei 四人可以坐。"
  },
  "r6-l3": {
    "en": "98afe218987d7ca247d1b632f00db3d17145f11420571f3eeb16de5b61b7ccc0",
    "glossYue": "可唔可以改時間，如果我哋遲啲到，訂位仲留住？"
  },
  "r6-l4": {
    "en": "09735d205ac895ac1f30cbd69b8bf960135d632439704bccce16d3b010d108f7",
    "glossYue": "我可以將時間改到八點，靠窗位仍然留低。"
  },
  "r6-l5": {
    "en": "4a32398aa192016c475a30511ba5f31c2a0d6af2d87fae2074045fa6e439cb92",
    "glossYue": "如果落雨，請取消室外位，留我哋喺室內。"
  },
  "r6-l6": {
    "en": "fa11417725b078d967305404aacfbf39e5a1b8e691b92bce787b5fcdb62b51c6",
    "glossYue": "室外位已經滿咗，但我可以將你哋放上候補。"
  },
  "r6-l7": {
    "en": "0340ea18937995db671367efc9c8bea007acc8aa32220a8d3a9d5432feb946b1",
    "glossYue": "請確認訂位，我哋大概幾點嚟？"
  },
  "r6-l8": {
    "en": "c0e3b5fb04c4e27a1be11e5eed8132dbcf27dcc300a0d751c44bf3a4fa3c916a",
    "glossYue": "我會留住個訂位到八點，再寄一則短訊。"
  },
  "t6-l1": {
    "en": "4c474735d129edfa0cd504da9f0acd26e54b2462a5988110942cdd5ba23afd3a",
    "glossYue": "晚安，我係前台 Kim。今晚有咩可以幫你？"
  },
  "t6-l2": {
    "en": "478c1f2f01896cf6bb9c2dde273a00cb8025fdce0542d161601a29cb719da752",
    "glossYue": "部冷氣好嘈，我喺呢間房幾乎瞓唔到。"
  },
  "t6-l3": {
    "en": "4aa87a195e7ef16a88c3ec2d5aac70112b760a7bedd45bd09d712aefcdcb5287",
    "glossYue": "造成不便，對唔住。我可以派工程師上嚟。"
  },
  "t6-l4": {
    "en": "bac48656f39d78a22adc52c72151634cd626024ad857354b2beb5e6c16dd1071",
    "glossYue": "可唔可以搬去靜啲嘅房，再加毛巾同一張被？"
  },
  "t6-l5": {
    "en": "cc6b0205075d94e054e892be66e317731c1c3ac24638b2ba93b96d4d1dec80b0",
    "glossYue": "樓上有間靜啲嘅房，我而家帶毛巾上嚟。"
  },
  "t6-l6": {
    "en": "8caa553add55911304dbdedb2d40c65e844ff4c9454524f91946681dcc2a8660",
    "glossYue": "部冷氣仍然好弱，唔該叫工程師檢查。"
  },
  "t6-l7": {
    "en": "5d2d519a2e1dd42968b94a5a6193baf005a121720b1ca741df4f26e4a406f1a8",
    "glossYue": "我記低嘈嘅位置，工程師會上嚟。"
  },
  "t6-l8": {
    "en": "884763b54eda6d7b4bed171dc0605c2691cad5e8a65f58533296f4610b792b42",
    "glossYue": "多謝工程師嚟睇、毛巾同暖被。"
  },
  "r9-l1": {
    "en": "14a4fd924c2f15426a61427b06b383afa6a82d4877e0c7de49728e340ef62488",
    "glossYue": "走之前可唔可以攞呢張檯嘅帳單？"
  },
  "r9-l2": {
    "en": "7e6803f02d2dbab14d7b18758874cdef0cde2de5a21e036fb13e8b781141c25a",
    "glossYue": "帳單喺度，服務費包咗。"
  },
  "r9-l3": {
    "en": "0e3bfe2f8e1a0ba74cd62764c3ec36069347450628ecc0592f3cf286bb897ab7",
    "glossYue": "可唔可以分開埋單，再要一張分開嘅收據？"
  },
  "r9-l4": {
    "en": "068fafa56d1841bf4b2811c08bf3a719712e991df9f9590acaeb96e156ada393",
    "glossYue": "可以分開，我會顯示兩個數。"
  },
  "r9-l5": {
    "en": "8d0616dc5626fce9a9da9e4ce17a20790eb683e7c0100888da4f0a5d465e2bf0",
    "glossYue": "我用八達通畀我嗰份。"
  },
  "r9-l6": {
    "en": "0273dbab7fcbbf48b8c77cfdf787fb4f27d5d5bce503ccda56041d5d419486e6",
    "glossYue": "我收八達通，然後印收據。"
  },
  "r9-l7": {
    "en": "6e4ea8b35ca7304847b9b728285a9a9d96256c66c730d909ef58df540cc60814",
    "glossYue": "帳單有個錯，湯係額外嘅。"
  },
  "r9-l8": {
    "en": "364c5149a3b700b8944a2e244916f88bf908bcaa628cf497b7904c88765911cd",
    "glossYue": "我會改好嗰個錯，再帶新帳單嚟。"
  }
}
